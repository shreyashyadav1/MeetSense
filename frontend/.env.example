# Copy to .env.local and adjust. Values are embedded in the client bundle at
# build time, so never put secrets here.

# Base URL of the MeetSense backend (REST under /api, WebSocket under /ws).
#
#   unset               -> http://localhost:8000 (a backend running locally)
#   https://api.host    -> REST on https://api.host, WebSocket on wss://api.host
#   empty (VITE_API_URL=) -> same-origin relative URLs; the WebSocket URL is
#                          derived from the page (ws:// or wss://). Use this
#                          behind a reverse proxy such as the Docker/nginx
#                          image, or with `npm run dev`, whose dev server
#                          proxies /api, /ws and /health to localhost:8000.
VITE_API_URL=http://localhost:8000
