# Copy to backend/.env. Every value can stay empty: the backend then runs in demo
# mode (scripted transcript, in-memory storage, AI insights disabled).

# Live transcription (console.deepgram.com). Empty: scripted mock transcript.
DEEPGRAM_API_KEY=
# true/false forces a mode. Empty: mock exactly when DEEPGRAM_API_KEY is empty.
MOCK_TRANSCRIPTION=

# AI insights (console.groq.com). Empty: POST /api/meetings/{id}/summarize returns 503.
GROQ_API_KEY=

# PostgreSQL, e.g. postgresql://user:password@host:5432/postgres
# (postgres:// URLs and ?sslmode= are accepted). Empty: in-memory storage.
DATABASE_URL=

# Redis, e.g. redis://localhost:6379. Empty: live transcripts are fanned out
# in-process only (fine for a single backend instance).
REDIS_URL=

# Optional settings (defaults shown):
# ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,https://meet-sense.vercel.app
# ALLOW_MEMORY_FALLBACK=true        # false: fail with 503 instead of using memory when PostgreSQL is down
# DB_DISABLE_STATEMENT_CACHE=false  # true behind PgBouncer or the Supabase pooler (port 6543)
# SESSION_MAX_SECONDS=1800          # maximum length of one live-stream connection
# WS_MAX_CONNECTIONS_PER_IP=3
# FORWARDED_ALLOW_IPS=*             # proxies trusted for X-Forwarded-For
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.3
# GROQ_MAX_TOKENS=2048
# GROQ_TIMEOUT_SECONDS=30
# AI_MAX_TRANSCRIPT_CHARS=32000
# PORT=8000
